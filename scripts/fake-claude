#!/bin/sh
# A fake `claude` for the tests. FAKE_MODE selects the answer.
case "${FAKE_MODE:-ok}" in
  ok)   echo '{"result":"hello","total_cost_usd":0.012,"session_id":"s-1"}' ;;
  auth) echo 'Failed to authenticate. API Error: 401 OAuth access token has expired.'; exit 0 ;;
  junk) echo 'not json at all' ;;
esac
